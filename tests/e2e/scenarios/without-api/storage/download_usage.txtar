# exo storage download: usage errors, raised before any API call

env EXOSCALE_CONFIG=test-config.toml

# Usage errors
! exec exo storage download
stderr 'error: invalid arguments'
stderr 'Usage:'
stderr 'exo storage download sos://BUCKET/\[OBJECT\|PREFIX/\] \[DESTINATION\]'
! exec exo storage download sos://my-bucket/a.txt x y
stderr 'error: invalid arguments'
! exec exo storage download sos://
stderr 'error: invalid argument: "sos://"'
! exec exo storage download sos:///a.txt
stderr 'error: invalid argument: "sos:///a.txt"'

-- test-config.toml --
defaultaccount = "Exoscale-Test"

[[accounts]]
name = "Exoscale-Test"
key = "EXOtest123"
secret = "testsecret123"
defaultZone = "ch-gva-2"
