# exo storage presign: usage errors, raised before any API call

env EXOSCALE_CONFIG=test-config.toml

# Usage errors
! exec exo storage presign
stderr 'error: invalid arguments'
stderr 'Usage:'
! exec exo storage presign --expires 900 sos://my-bucket/hello.txt
stderr 'missing unit in duration "900"'

# A bucket without an object key
! exec exo storage presign sos://my-bucket
stderr 'invalid object URL'

-- test-config.toml --
defaultaccount = "Exoscale-Test"

[[accounts]]
name = "Exoscale-Test"
key = "EXOtest123"
secret = "testsecret123"
defaultZone = "ch-gva-2"
