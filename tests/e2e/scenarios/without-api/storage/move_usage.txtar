# exo storage move: usage errors, raised before any API call

env EXOSCALE_CONFIG=test-config.toml

# Usage and validation errors
! exec exo storage move sos://my-bucket/a.txt
stderr 'error: invalid arguments'
stderr 'Usage:'
stderr 'exo storage move sos://BUCKET/\[OBJECT\|PREFIX/\] sos://BUCKET/\[OBJECT\|PREFIX/\]'
! exec exo storage move sos://my-bucket/a.txt sos://my-bucket/a.txt
stderr 'error: source and destination must differ'
! exec exo storage move -r sos://my-bucket/dir sos://my-bucket/dir-backup
stderr 'error: source and destination prefixes must not overlap'

-- test-config.toml --
defaultaccount = "Exoscale-Test"

[[accounts]]
name = "Exoscale-Test"
key = "EXOtest123"
secret = "testsecret123"
defaultZone = "ch-gva-2"
