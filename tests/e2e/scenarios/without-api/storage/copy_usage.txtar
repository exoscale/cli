# exo storage copy: usage errors, raised before any API call

env EXOSCALE_CONFIG=test-config.toml

# Usage and validation errors
! exec exo storage copy sos://my-bucket/a.txt
stderr 'error: invalid arguments'
stderr 'Usage:'
stderr 'exo storage copy sos://BUCKET/\[OBJECT\|PREFIX/\] sos://BUCKET/\[OBJECT\|PREFIX/\]'
! exec exo storage copy sos://my-bucket/a.txt sos://my-bucket/a.txt
stderr 'error: source and destination must differ'
! exec exo storage copy sos://my-bucket/dir/ sos://my-bucket/dir/backup/
stderr 'error: source and destination prefixes must not overlap'

-- test-config.toml --
defaultaccount = "Exoscale-Test"

[[accounts]]
name = "Exoscale-Test"
key = "EXOtest123"
secret = "testsecret123"
defaultZone = "ch-gva-2"
