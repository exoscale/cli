# exo storage headers add/delete: usage errors, raised before any API call

env EXOSCALE_CONFIG=test-config.toml

# Usage errors
! exec exo storage headers add
stderr 'error: invalid arguments'
stderr 'Usage:'
stderr 'exo storage headers add sos://BUCKET/\(OBJECT\|PREFIX/\)'
! exec exo storage headers add sos://my-bucket --cache-control no-store
stderr 'error: invalid argument: "my-bucket"'
! exec exo storage headers add sos://my-bucket/obj.txt
stderr 'error: no header flag specified'
! exec exo storage headers add sos://my-bucket/obj.txt --cache-control ''
stderr 'error: no header flag specified'
! exec exo storage headers delete sos://my-bucket/obj.txt
stderr 'error: no header flag specified'
! exec exo storage headers delete sos://my-bucket/obj.txt --cache-control=false
stderr 'error: no header flag specified'

-- test-config.toml --
defaultaccount = "Exoscale-Test"

[[accounts]]
name = "Exoscale-Test"
key = "EXOtest123"
secret = "testsecret123"
defaultZone = "ch-gva-2"
