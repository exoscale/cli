# exo storage purge: usage errors, raised before any API call

env EXOSCALE_CONFIG=test-config.toml

# Usage errors
! exec exo storage purge
stderr 'error: invalid arguments'
stderr 'Usage:'
stderr 'exo storage purge sos://BUCKET/\[OBJECT\|PREFIX/\]'
! exec exo storage purge -f sos://my-bucket/ sos://my-bucket/dir/
stderr 'error: invalid arguments'
! exec exo storage purge -f sos://
stderr 'error: invalid argument: "sos://"'
! exec exo storage purge -f sos:///dir/
stderr 'error: invalid argument: "sos:///dir/"'

-- test-config.toml --
defaultaccount = "Exoscale-Test"

[[accounts]]
name = "Exoscale-Test"
key = "EXOtest123"
secret = "testsecret123"
defaultZone = "ch-gva-2"
