# exo storage mb: usage errors, raised before any API call

env EXOSCALE_CONFIG=test-config.toml

# Usage errors
! exec exo storage mb
stderr 'error: invalid arguments'
stderr 'Usage:'
stderr 'exo storage mb sos://BUCKET'
! exec exo storage mb sos://my-bucket sos://my-bucket2
stderr 'error: invalid arguments'
! exec exo storage mb sos://
stderr 'error: invalid argument: "sos://"'
! exec exo storage mb sos://my-bucket/obj.txt
stderr 'error: invalid argument: "sos://my-bucket/obj.txt", expected a bucket name'

# The help points to the ACL documentation
exec exo storage mb --help
stdout 'https://community.exoscale.com/product/storage/object-storage/how-to/acl/'

-- test-config.toml --
defaultaccount = "Exoscale-Test"

[[accounts]]
name = "Exoscale-Test"
key = "EXOtest123"
secret = "testsecret123"
defaultZone = "ch-gva-2"
