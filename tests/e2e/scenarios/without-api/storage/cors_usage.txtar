# exo storage cors add/delete: usage errors, raised before any API call

env EXOSCALE_CONFIG=test-config.toml

# Usage errors
! exec exo storage cors add
stderr 'error: invalid arguments'
stderr 'Usage:'
! exec exo storage cors delete a b
stderr 'error: invalid arguments'

# --allowed-origin and --allowed-method are required, checked before any API call
! exec exo storage cors add sos://my-bucket
stderr 'no value specified for flag "allowed-method"'
stderr 'no value specified for flag "allowed-origin"'
! exec exo storage cors add sos://my-bucket --allowed-origin https://a.example
stderr 'no value specified for flag "allowed-method"'
! stderr 'allowed-origin'

-- test-config.toml --
defaultaccount = "Exoscale-Test"

[[accounts]]
name = "Exoscale-Test"
key = "EXOtest123"
secret = "testsecret123"
defaultZone = "ch-gva-2"
