# exo storage mb: zone, canned ACL, alias, output formats

# Usage errors, no API call needed
! exec exo storage mb
stderr 'error: invalid arguments'
stderr 'Usage:'
stderr 'exo storage mb sos://BUCKET'
! exec exo storage mb sos://sto-mb-$TEST_RUN_ID sos://sto-mb2-$TEST_RUN_ID
stderr 'error: invalid arguments'
! exec exo storage mb sos://
stderr 'error: invalid argument: "sos://"'

# The help points to the ACL documentation
exec exo storage mb --help
stdout 'https://community.exoscale.com/product/storage/object-storage/how-to/acl/'

# An unknown canned ACL is a usage error, no bucket is created
! exec exo --zone $TEST_ZONE storage mb --acl bogus sos://sto-mb-$TEST_RUN_ID
stderr 'error: invalid canned ACL "bogus", supported values are: private, public-read, public-read-write, authenticated-read'
stderr 'Usage:'
! exec exo storage show sos://sto-mb-$TEST_RUN_ID

# Create, sos:// syntax, zone flag, JSON output
exec exo --output-format json storage mb --zone $TEST_ZONE sos://sto-mb-$TEST_RUN_ID
defer exo storage rb -f sos://sto-mb-$TEST_RUN_ID
stdout '"name":"sto-mb-'$TEST_RUN_ID'"'
stdout '"zone":"'$TEST_ZONE'"'
stdout '"read":"-"'

# create alias, bare bucket name, canned ACL, output template
exec exo --output-template '{{.Name}} {{.Zone}} {{.ACL.Read}}' storage create -z $TEST_ZONE --acl public-read sto-mb2-$TEST_RUN_ID
defer exo storage rb -f sos://sto-mb2-$TEST_RUN_ID
stdout '^sto-mb2-'$TEST_RUN_ID' '$TEST_ZONE' ALL_USERS$'

# Trailing slash on the bucket, quiet mode prints nothing, the bucket exists
exec exo -Q storage mb -z $TEST_ZONE sos://sto-mb3-$TEST_RUN_ID/
defer exo storage rb -f sos://sto-mb3-$TEST_RUN_ID
! stdout .
exec exo --output-format json storage show sos://sto-mb3-$TEST_RUN_ID
stdout '"name":"sto-mb3-'$TEST_RUN_ID'"'
