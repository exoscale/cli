# `exo storage bucket object-ownership` after its migration to the clicmd
# framework: status and the three settings, sos:// and bare bucket syntaxes,
# --zone and -z, the oo alias, JSON output and the legacy usage errors.

# Usage errors are unchanged, no API call needed
! exec exo storage bucket object-ownership status
stderr 'error: invalid arguments'
stderr 'Usage:'
! exec exo storage bucket object-ownership destroy sos://sto-oo-$TEST_RUN_ID
stderr 'error: invalid operation'

# Setup: bucket
exec exo --zone $TEST_ZONE --output-format json storage mb sos://sto-oo-$TEST_RUN_ID
defer exo storage rb -f sos://sto-oo-$TEST_RUN_ID

# A new bucket enforces bucket ownership, sos:// syntax and --zone, JSON output
exec exo --output-format json storage bucket object-ownership status --zone $TEST_ZONE sos://sto-oo-$TEST_RUN_ID
stdout '"bucket":"sto-oo-'$TEST_RUN_ID'"'
stdout '"objectOwnership":"BucketOwnerEnforced"'

# object-writer, bare bucket name and -z, table output
exec exo storage bucket object-ownership object-writer -z $TEST_ZONE sto-oo-$TEST_RUN_ID
exec exo storage bucket object-ownership status -z $TEST_ZONE sto-oo-$TEST_RUN_ID
stdout 'ObjectWriter'

# bucket-owner-preferred with the oo alias
exec exo storage bucket oo bucket-owner-preferred --zone $TEST_ZONE sos://sto-oo-$TEST_RUN_ID
exec exo --output-format json storage bucket oo status --zone $TEST_ZONE sos://sto-oo-$TEST_RUN_ID
stdout '"objectOwnership":"BucketOwnerPreferred"'

# Back to bucket-owner-enforced
exec exo storage bucket oo bucket-owner-enforced --zone $TEST_ZONE sos://sto-oo-$TEST_RUN_ID
exec exo --output-format json storage bucket oo status --zone $TEST_ZONE sos://sto-oo-$TEST_RUN_ID
stdout '"objectOwnership":"BucketOwnerEnforced"'
