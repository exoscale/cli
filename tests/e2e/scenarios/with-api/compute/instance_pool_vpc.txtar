# Test: exo compute instance-pool create/update/show support --vpc,
# --vpc-subnet and --ip-forwarding.
# Creates a VPC with two Subnets, then an Instance Pool attached at creation
# time (VPC and Subnet by name), updates its Subnets (by ID), checks that an
# unrelated update keeps the VPC, toggles IP forwarding and detaches the VPC.
# TEST_ZONE and TEST_RUN_ID are injected by the API test runner.

# Setup: VPC + two Subnets. The VPC name differs from instance_create_vpc's,
# which runs in parallel in the same run.
exec exo --zone $TEST_ZONE --output-format json networking vpc create vpc-pool-$TEST_RUN_ID
json-setenv VPC_ID id stdout
defer exo --zone $TEST_ZONE networking vpc delete --force $VPC_ID

exec exo --zone $TEST_ZONE --output-format json networking vpc subnet create $VPC_ID front-$TEST_RUN_ID --ipv4-block 10.43.0.0/24 --address-family inet4 --address-space private
json-setenv FRONT_ID id stdout
defer exo --zone $TEST_ZONE networking vpc subnet delete --force $VPC_ID $FRONT_ID

exec exo --zone $TEST_ZONE --output-format json networking vpc subnet create $VPC_ID back-$TEST_RUN_ID --ipv4-block 10.43.1.0/24 --address-family inet4 --address-space private
json-setenv BACK_ID id stdout
defer exo --zone $TEST_ZONE networking vpc subnet delete --force $VPC_ID $BACK_ID

# Unknown Subnets are rejected
! exec exo --zone $TEST_ZONE compute instance-pool create pool-err-$TEST_RUN_ID --instance-type standard.tiny --template 'Linux Ubuntu 22.04 LTS 64-bit' --disk-size 10 --vpc vpc-pool-$TEST_RUN_ID --vpc-subnet nope
stderr 'subnet "nope" not found'

# Instance Pool attached to a VPC Subnet, VPC and Subnet referenced by name
exec exo --zone $TEST_ZONE --output-format json compute instance-pool create pool-$TEST_RUN_ID --size 1 --instance-type standard.tiny --template 'Linux Ubuntu 22.04 LTS 64-bit' --disk-size 10 --vpc vpc-pool-$TEST_RUN_ID --vpc-subnet front-$TEST_RUN_ID --ip-forwarding
json-setenv POOL_ID id stdout
defer exo --zone $TEST_ZONE compute instance-pool delete --force $POOL_ID
stdout '"vpc":"vpc-[a-z0-9-]+"'
stdout '"vpc_subnets":\["front-[a-z0-9-]+ 10\.43\.0\.0/24"\]'
stdout '"ip_forwarding":true'

# Replace the Subnets, VPC and Subnets referenced by ID
exec exo --zone $TEST_ZONE --output-format json compute instance-pool update $POOL_ID --vpc $VPC_ID --vpc-subnet $FRONT_ID --vpc-subnet $BACK_ID
stdout '"vpc_subnets":\[[^]]*"front-[a-z0-9-]+ 10\.43\.0\.0/24"[^]]*\]'
stdout '"vpc_subnets":\[[^]]*"back-[a-z0-9-]+ 10\.43\.1\.0/24"[^]]*\]'

# An unrelated update keeps the VPC and IP forwarding
exec exo --zone $TEST_ZONE --output-format json compute instance-pool update $POOL_ID --description vpc-test
stdout '"description":"vpc-test"'
stdout '"vpc":"vpc-[a-z0-9-]+"'
stdout '"vpc_subnets":\[[^]]*"front-[a-z0-9-]+ 10\.43\.0\.0/24"[^]]*\]'
stdout '"vpc_subnets":\[[^]]*"back-[a-z0-9-]+ 10\.43\.1\.0/24"[^]]*\]'
stdout '"ip_forwarding":true'

# Disable IP forwarding
exec exo --zone $TEST_ZONE --output-format json compute instance-pool update $POOL_ID --ip-forwarding=false
stdout '"ip_forwarding":false'
stdout '"vpc":"vpc-[a-z0-9-]+"'

# Detach the Instance Pool from its VPC
exec exo --zone $TEST_ZONE --output-format json compute instance-pool update $POOL_ID --vpc ''
stdout '"vpc":""'
stdout '"vpc_subnets":\[\]'

exec exo --zone $TEST_ZONE --output-format json compute instance-pool show $POOL_ID
stdout '"vpc":""'
stdout '"vpc_subnets":\[\]'
