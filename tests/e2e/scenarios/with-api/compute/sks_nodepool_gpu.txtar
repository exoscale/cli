# SKS GPU Nodepool: Nvidia DRA driver and MIG profile, on create and update.
# Needs a GPU instance type available in $TEST_ZONE, so this scenario needs
# TEST_GPU_INSTANCE_TYPE (e.g. gpua30.small) and a MIG profile valid for it in
# TEST_GPU_MIG_PROFILE (e.g. 4g.24gb).
# Every command passes -z $TEST_ZONE: the CLI does not read EXO_ZONE.
[!gpu] skip 'TEST_GPU_* not set'

exec exo --output-format json compute sks create $TEST_RUN_ID-sks -z $TEST_ZONE --service-level starter
defer exo compute sks delete --force --nodepools -z $TEST_ZONE $TEST_RUN_ID-sks

exec exo --output-format json compute sks nodepool add -z $TEST_ZONE $TEST_RUN_ID-sks $TEST_RUN_ID-gpu --size 1 --instance-type $TEST_GPU_INSTANCE_TYPE --nvidia-dra-driver --nvidia-mig-profile $TEST_GPU_MIG_PROFILE
stdout '"nvidia_dra_driver":true'
stdout '"nvidia_mig_profile":"'$TEST_GPU_MIG_PROFILE'"'

# Back to the Nvidia device plugin, without MIG
exec exo --output-format json compute sks nodepool update -z $TEST_ZONE $TEST_RUN_ID-sks $TEST_RUN_ID-gpu --nvidia-dra-driver=false --nvidia-mig-profile ''
stdout '"nvidia_dra_driver":false'
stdout '"nvidia_mig_profile":""'
