# KMS key store lifecycle: create -> list -> get -> update -> connect/disconnect -> delete.
# Creating a key store validates a live XKS proxy, so this scenario needs
# XKS_PROXY_ENDPOINT, XKS_PROXY_ACCESS_KEY and XKS_PROXY_SECRET_KEY.
# Every command passes -z $TEST_ZONE: the CLI does not read EXO_ZONE, so it
# would otherwise fall back to its default zone (ch-dk-2).
[!xks] skip 'XKS_PROXY_* not set'

# Create a key store, left disconnected by default
exec exo --output-format json kms keystore create -z $TEST_ZONE $TEST_RUN_ID-xks $XKS_PROXY_ENDPOINT --access-key $XKS_PROXY_ACCESS_KEY --secret-key $XKS_PROXY_SECRET_KEY --description 'cli e2e'
cp stdout create.json
json-setenv KEYSTORE_ID id create.json
stdout '"status":"disconnected"'
stdout '"type":"external-key-store"'
! stdout $XKS_PROXY_SECRET_KEY

# The new key store shows up in the list
exec exo --output-format json kms keystore list -z $TEST_ZONE
stdout $KEYSTORE_ID

# Show by ID, also through the get alias
exec exo --output-format json kms keystore show -z $TEST_ZONE $KEYSTORE_ID
stdout $TEST_RUN_ID-xks
exec exo --output-format json kms keystore get -z $TEST_ZONE $KEYSTORE_ID
stdout $TEST_RUN_ID-xks

# Update the description
exec exo --output-format json kms keystore update -z $TEST_ZONE $KEYSTORE_ID --description 'cli e2e updated'
stdout 'cli e2e updated'

# Update rejects an access key without its secret
! exec exo kms keystore update -z $TEST_ZONE $KEYSTORE_ID --access-key $XKS_PROXY_ACCESS_KEY
stderr 'must be set together'

# Connect, then disconnect
exec exo --output-format json kms keystore connect -z $TEST_ZONE $KEYSTORE_ID
stdout '"status":"connected"'
exec exo --output-format json kms keystore disconnect -z $TEST_ZONE $KEYSTORE_ID
stdout '"status":"disconnected"'

# Flag variant: --connect-on-create returns a connected key store
exec exo --output-format json kms keystore create -z $TEST_ZONE $TEST_RUN_ID-xks-2 $XKS_PROXY_ENDPOINT --access-key $XKS_PROXY_ACCESS_KEY --secret-key $XKS_PROXY_SECRET_KEY --connect-on-create
cp stdout create2.json
json-setenv KEYSTORE_ID2 id create2.json
stdout '"status":"connected"'
exec exo kms keystore disconnect -z $TEST_ZONE $KEYSTORE_ID2

# Key stores are referenced by ID only: a name is rejected before any API call
! exec exo kms keystore show -z $TEST_ZONE $TEST_RUN_ID-xks
stderr 'invalid key store ID'

# Showing an unknown key store fails
! exec exo kms keystore show -z $TEST_ZONE 00000000-0000-4000-8000-000000000000
stderr '(?i)not found'

# Delete both key stores, one at a time (force skips the confirmation prompt)
exec exo kms keystore delete -z $TEST_ZONE -f $KEYSTORE_ID
stdout 'deleted'
exec exo kms keystore delete -z $TEST_ZONE -f $KEYSTORE_ID2
stdout 'deleted'

exec exo --output-format json kms keystore list -z $TEST_ZONE
! stdout $KEYSTORE_ID
! stdout $KEYSTORE_ID2
