# KMS key store lifecycle: create -> list -> get -> update -> connect/disconnect -> delete.
# Creating a key store validates a live XKS proxy, so this scenario needs
# XKS_PROXY_ENDPOINT, XKS_PROXY_ACCESS_KEY and XKS_PROXY_SECRET_KEY.
[!xks] skip 'XKS_PROXY_* not set'

# Create a key store, left disconnected by default
exec exo --output-format json kms keystore create $TEST_RUN_ID-xks $XKS_PROXY_ENDPOINT --access-key $XKS_PROXY_ACCESS_KEY --secret-key $XKS_PROXY_SECRET_KEY --description 'cli e2e'
cp stdout create.json
json-setenv KEYSTORE_ID id create.json
stdout '"status":"disconnected"'
stdout '"type":"external-key-store"'
! stdout $XKS_PROXY_SECRET_KEY

# The new key store shows up in the list
exec exo --output-format json kms keystore list
stdout $KEYSTORE_ID

# Get by name, and by ID through the info/show aliases
exec exo --output-format json kms keystore get $TEST_RUN_ID-xks
stdout $KEYSTORE_ID
exec exo --output-format json kms keystore info $KEYSTORE_ID
stdout $TEST_RUN_ID-xks
exec exo --output-format json kms keystore show $KEYSTORE_ID
stdout $TEST_RUN_ID-xks

# Update the description
exec exo --output-format json kms keystore update $KEYSTORE_ID --description 'cli e2e updated'
stdout 'cli e2e updated'

# Update rejects an access key without its secret
! exec exo kms keystore update $KEYSTORE_ID --access-key $XKS_PROXY_ACCESS_KEY
stderr 'must be set together'

# Connect, then disconnect
exec exo --output-format json kms keystore connect $KEYSTORE_ID
stdout '"status":"connected"'
exec exo --output-format json kms keystore disconnect $TEST_RUN_ID-xks
stdout '"status":"disconnected"'

# Flag variant: --connect-on-create returns a connected key store
exec exo --output-format json kms keystore create $TEST_RUN_ID-xks-2 $XKS_PROXY_ENDPOINT --access-key $XKS_PROXY_ACCESS_KEY --secret-key $XKS_PROXY_SECRET_KEY --connect-on-create
cp stdout create2.json
json-setenv KEYSTORE_ID2 id create2.json
stdout '"status":"connected"'
exec exo kms keystore disconnect $KEYSTORE_ID2

# Getting an unknown key store fails
! exec exo kms keystore get nonexistent-e2e-keystore
stderr 'not found'

# Delete both key stores (force skips the confirmation prompt)
exec exo kms keystore delete -f $KEYSTORE_ID $KEYSTORE_ID2
stdout 'deleted'

exec exo --output-format json kms keystore list
! stdout $KEYSTORE_ID
! stdout $KEYSTORE_ID2
