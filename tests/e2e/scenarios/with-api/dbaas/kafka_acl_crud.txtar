# Test: dbaas acl create/list/show/delete on a Kafka service
# Covers topic and Schema Registry entries, the --permission selector of
# delete, and the unsupported update.
# TEST_ZONE and TEST_RUN_ID are injected by the API test runner.

# Create a Kafka service (disable termination protection for cleanup)
exec exo --zone $TEST_ZONE --output-format json dbaas create kafka startup-2 kafka-acl-$TEST_RUN_ID --kafka-enable-schema-registry --termination-protection=false

# Wait for the service to be running
wait-dbaas-state $TEST_ZONE kafka-acl-$TEST_RUN_ID running 1200

# Create two topic entries for the same user and topic
exec exo --zone $TEST_ZONE --output-format json dbaas acl create kafka-acl-$TEST_RUN_ID acluser --kafka-topic orders --permission read
stdout '"resource":"orders"'
exec exo --zone $TEST_ZONE dbaas acl create kafka-acl-$TEST_RUN_ID acluser --kafka-topic orders --permission write

# Create a Schema Registry entry
exec exo --zone $TEST_ZONE dbaas acl create kafka-acl-$TEST_RUN_ID acluser --kafka-schema-registry-resource Subject:orders --permission schema_registry_read

# A kafka entry needs a topic or a Schema Registry resource
! exec exo --zone $TEST_ZONE dbaas acl create kafka-acl-$TEST_RUN_ID acluser --permission read
stderr 'is required'

# List and show return the entries of both kinds
exec exo --zone $TEST_ZONE --output-format json dbaas acl list kafka-acl-$TEST_RUN_ID
stdout '"kind":"topic"'
stdout '"kind":"schema-registry"'
stdout '"permission":"schema_registry_read"'
exec exo --zone $TEST_ZONE dbaas acl show kafka-acl-$TEST_RUN_ID
stdout 'acluser'

# Kafka entries cannot be updated
! exec exo --zone $TEST_ZONE dbaas acl update kafka-acl-$TEST_RUN_ID --opensearch-acl-enabled
stderr 'unsupported'

# Two entries match the user and topic: --permission is needed
! exec exo --zone $TEST_ZONE dbaas acl delete kafka-acl-$TEST_RUN_ID acluser --kafka-topic orders -f
stderr 'use --permission'

# Delete the entries one by one
exec exo --zone $TEST_ZONE dbaas acl delete kafka-acl-$TEST_RUN_ID acluser --kafka-topic orders --permission write -f
exec exo --zone $TEST_ZONE dbaas acl delete kafka-acl-$TEST_RUN_ID acluser --kafka-topic orders -f
exec exo --zone $TEST_ZONE dbaas acl delete kafka-acl-$TEST_RUN_ID acluser --kafka-schema-registry-resource Subject:orders -f

exec exo --zone $TEST_ZONE --output-format json dbaas acl list kafka-acl-$TEST_RUN_ID
! stdout 'acluser'

# Teardown: delete the service
exec exo --zone $TEST_ZONE dbaas delete -f kafka-acl-$TEST_RUN_ID
