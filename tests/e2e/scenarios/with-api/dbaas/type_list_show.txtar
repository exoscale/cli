# Test: dbaas type list/show
# Read-only: queries the Database Service types catalog, creates nothing.
# TEST_ZONE is injected by the API test runner.

# List service types
exec exo --zone $TEST_ZONE dbaas type list
stdout 'Available Versions'
stdout 'pg'
exec exo --zone $TEST_ZONE --output-format json dbaas type list
stdout '"name": ?"pg"'
stdout '"default_version"'

# Show a service type
exec exo --zone $TEST_ZONE dbaas type show pg
stdout 'Description'
stdout 'Default Version'
exec exo --zone $TEST_ZONE --output-format json dbaas type show pg
stdout '"name": ?"pg"'

# --plans lists the plans offered
exec exo --zone $TEST_ZONE --output-format json dbaas type show pg --plans
stdout '"node_cpus"'
stdout '"authorized"'

# --backup-config shows the backup configuration of a plan
exec exo --zone $TEST_ZONE --output-format json dbaas type show pg --backup-config hobbyist-2
stdout '"max_count"'
! exec exo --zone $TEST_ZONE dbaas type show pg --backup-config no-such-plan
stderr '"no-such-plan" is not a valid plan'

# --settings shows the settings schema of a settings group
exec exo --zone $TEST_ZONE dbaas type show pg --settings pgbouncer
stdout 'description'
! exec exo --zone $TEST_ZONE dbaas type show pg --settings kafka
stderr 'invalid settings value "kafka", expected one of: pg, pgbouncer, pglookout, timescaledb'
